APP_NAME=IssuePilot
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/issuepilot
DB_POOL_SIZE=10

QDRANT_HOST=localhost
QDRANT_PORT=6333
# Only needed if the Qdrant server was started with an API key
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_COLLECTION=issuepilot_knowledge
QDRANT_ISSUES_COLLECTION=issue_embeddings

HF_TOKEN=

# =====================================================
# GITHUB OAUTH
# =====================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

FRONTEND_URL=http://localhost:5173

# =====================================================
# GITHUB API
# =====================================================

# Personal access token used by ingestion jobs (repo discovery, issues, events)
GITHUB_INGEST_TOKEN=

# =====================================================
# JWT
# =====================================================

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# =====================================================
# GROQ
# =====================================================

GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
AGENT_TIMEOUT_SECONDS=30
# How long a saved success prediction is reused before the agent runs again
PREDICTION_TTL_HOURS=72

# =====================================================
# SCHEDULER
# =====================================================

SCHEDULER_ENABLED=true

# =====================================================
# ADMIN
# =====================================================

# Required to call /admin/* and /rag/ingest (send as the X-Admin-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# /rag/ingest only reads PDFs from inside this directory
RAG_DOCUMENTS_DIR=data/documents
